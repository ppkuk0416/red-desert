# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
# Supabase 프로젝트 대시보드 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버에서만 사용 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────
# Database (Supabase Postgres)
# ──────────────────────────────────────────────
# Transaction mode — 커넥션 풀링, 포트 6543 (Prisma 런타임)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15
# Session mode — 포트 5432 (prisma migrate deploy 전용)
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────
# Meilisearch
# ──────────────────────────────────────────────
# 자체 호스팅: http://localhost:7700 / Meilisearch Cloud: https://xxx.meilisearch.io
MEILISEARCH_HOST=http://localhost:7700
# 마스터 키 (서버 전용, admin API)
MEILISEARCH_API_KEY=your-master-key
# 검색 전용 키 (읽기 only — Meilisearch 대시보드 > Keys > Search key)
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=your-search-only-key

# ──────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────
# 어드민 API 보호 — openssl rand -hex 32 로 생성 권장
ADMIN_SECRET=your-random-secret-here
# 어드민 패널 URL 파라미터 키 (?key=xxx)
NEXT_PUBLIC_ADMIN_KEY=your-admin-panel-key

# ──────────────────────────────────────────────
# 앱 URL (선택) — OG 이미지 절대경로, sitemap용
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://red-desert.gg
