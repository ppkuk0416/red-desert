generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Locale {
  ko
  en
}

enum WeaponType {
  SWORD_SHIELD
  GREATSWORD
  SPEAR
  DAGGER
  BOW
  CROSSBOW
  STAFF
  SCYTHE
  HAMMER
  FLAIL
  TWIN_SWORDS
  BARE_HANDS
  SPECIAL
}

enum BossMechanic {
  PARRY
  COUNTER
  CLIMB
  SUMMON
  ELEMENTAL
  MOUNTED
}

enum ItemCategory {
  WEAPON
  ARMOR
  MATERIAL
  CONSUMABLE
  ABYSS_ARTIFACT
  COLLECTIBLE
  QUEST
  TRADE_GOOD
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum DropSourceType {
  BOSS
  MONSTER
  CRAFT
  NPC
  EXPLORATION
  TRADE
}

enum MarkerType {
  BELL
  ARTIFACT
  TABLET
  BOSS_SPAWN
  NPC
  DUNGEON
  VIEWPOINT
}

enum Region {
  PYWEL_CASTLE
  THORNWOOD
  ASHEN_WASTES
  FROZEN_HIGHLANDS
  VERDANT_COAST
}

enum Character {
  KLIFF
  DAMIANE
  OONGKA
}

enum BuildPlaystyle {
  MAIN_STORY
  BOSS_HUNTER
  COMPLETIONIST
  EXPLORER
}

enum ContributionType {
  DROP_RATE
  MAP_MARKER
  BOSS_TIP
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// Boss
// ─────────────────────────────────────────────

model Boss {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameKo        String
  nameEn        String
  region        Region
  difficulty    Int            @default(1) // 1-5
  hpEstimate    BigInt?
  thumbnailUrl  String?
  videoUrl      String?
  mechanics     BossMechanic[]
  weaknesses    WeaponType[]
  drops         BossDrop[]
  mapMarkers    MapMarker[]
  respawnMinutes Int?                       // 리젠 시간 (분), null = 미확인
  communityRating Float?       @default(0)
  viewCount     Int            @default(0)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([region])
  @@index([slug])
}

model BossDrop {
  id          String     @id @default(cuid())
  boss        Boss       @relation(fields: [bossId], references: [id])
  bossId      String
  item        Item       @relation(fields: [itemId], references: [id])
  itemId      String
  dropRate    Float?     // null = unknown
  quantity    Int        @default(1)
  isGuaranteed Boolean   @default(false)

  @@unique([bossId, itemId])
  @@index([bossId])
  @@index([itemId])
}

// ─────────────────────────────────────────────
// Item
// ─────────────────────────────────────────────

model Item {
  id          String       @id @default(cuid())
  slug        String       @unique
  nameKo      String
  nameEn      String
  category    ItemCategory
  rarity      ItemRarity   @default(COMMON)
  iconUrl     String?
  descriptionKo String?
  descriptionEn String?
  codexId     String?      // Knowledge Codex 연결
  bossDrops   BossDrop[]
  dropSources DropSource[]
  craftedFrom CraftRecipe[] @relation("CraftOutput")
  usedInCraft CraftIngredient[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@index([nameKo])
  @@index([nameEn])
}

model DropSource {
  id         String         @id @default(cuid())
  item       Item           @relation(fields: [itemId], references: [id])
  itemId     String
  sourceType DropSourceType
  sourceName String         // 몬스터명 or NPC명 등
  sourceId   String?        // Boss.id 등 선택적 참조
  region     Region?
  dropRate   Float?
  notes      String?

  @@index([itemId])
  @@index([sourceType])
}

model CraftRecipe {
  id           String            @id @default(cuid())
  outputItem   Item              @relation("CraftOutput", fields: [outputItemId], references: [id])
  outputItemId String
  outputQty    Int               @default(1)
  ingredients  CraftIngredient[]
  craftStation String?           // 제작 시설명
  notes        String?
}

model CraftIngredient {
  id       String      @id @default(cuid())
  recipe   CraftRecipe @relation(fields: [recipeId], references: [id])
  recipeId String
  item     Item        @relation(fields: [itemId], references: [id])
  itemId   String
  quantity Int         @default(1)
}

// ─────────────────────────────────────────────
// Map
// ─────────────────────────────────────────────

model MapMarker {
  id          String     @id @default(cuid())
  type        MarkerType
  region      Region
  x           Float
  y           Float
  nameKo      String
  nameEn      String
  isMissable  Boolean    @default(false)
  boss        Boss?      @relation(fields: [bossId], references: [id])
  bossId      String?
  notes       String?
  isVerified  Boolean    @default(false)
  contributor String?    // userId
  createdAt   DateTime   @default(now())

  @@index([region])
  @@index([type])
}

// ─────────────────────────────────────────────
// Build
// ─────────────────────────────────────────────

model Build {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  character       Character
  weaponPrimary   WeaponType
  weaponSecondary WeaponType?
  skills          BuildSkill[]
  playstyle       BuildPlaystyle
  descriptionKo   String?
  descriptionEn   String?
  author          UserProfile?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  upvotes         Int            @default(0)
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  likes           Like[]
  bookmarks       Bookmark[]
  comments        Comment[]

  @@index([character])
  @@index([weaponPrimary])
  @@index([authorId])
}

model BuildSkill {
  id      String @id @default(cuid())
  build   Build  @relation(fields: [buildId], references: [id])
  buildId String
  skillId String // 게임 내 스킬 ID
  level   Int    @default(1)
  order   Int    @default(0)

  @@index([buildId])
}

// ─────────────────────────────────────────────
// 유저
// ─────────────────────────────────────────────

model UserProfile {
  id          String    @id  // Supabase auth UID
  username    String    @unique
  avatarUrl   String?
  bio         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  builds      Build[]
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]
  contributions Contribution[]

  @@index([username])
}

// ─────────────────────────────────────────────
// 소셜
// ─────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId   String
  createdAt DateTime @default(now())

  @@unique([userId, buildId])
  @@index([buildId])
}

model Bookmark {
  id        String   @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId   String
  createdAt DateTime @default(now())

  @@unique([userId, buildId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId   String
  content   String   @db.VarChar(1000)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// 커뮤니티 기여
// ─────────────────────────────────────────────

model Contribution {
  id        String             @id @default(cuid())
  type      ContributionType
  status    ContributionStatus @default(PENDING)
  user      UserProfile?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?            // Supabase auth UID (익명 허용)
  targetId  String             // bossId / itemId 등
  data      Json               // 제보 내용 자유 형식
  note      String?            // 제보자 메모
  createdAt DateTime           @default(now())

  @@index([type, status])
  @@index([targetId])
  @@index([userId])
}
